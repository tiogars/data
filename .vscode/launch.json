{
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot-DataApplication<data>",
            "request": "launch",
            "cwd": "${workspaceFolder}/data-server",
            "mainClass": "fr.tiogars.data.DataApplication",
            "projectName": "data",
            "args": "",
            "envFile": "${workspaceFolder}/data-server/.env"
        },
        {
            "type": "java",
            "name": "Spring Boot-Gateway<data>",
            "request": "launch",
            "cwd": "${workspaceFolder}/data-gateway",
            "mainClass": "fr.tiogars.data.gateway.GatewayApplication",
            "projectName": "data-gateway",
            "args": "",
            "envFile": "${workspaceFolder}/data-gateway/.env"
        },
        {
            "name": "Vite Dev Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}/data-web"
        },
        {
            "type": "msedge",
            "request": "launch",
            "cleanUp": "wholeBrowser",
            "name": "Launch Edge against localhost",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/data-web",
            "resolveSourceMapLocations": [
                "${workspaceFolder}/data-web/**",
                "!**/node_modules/**"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Web Debug (Spring + Vite + Edge)",
            "configurations": [
                "Spring Boot-DataApplication<data>",
                "Spring Boot-Gateway<data>",
                "Vite Dev Server",
                "Launch Edge against localhost"
            ],
            "stopAll": true
        }
    ]
}
